generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String        @id @default(cuid())
  name        String
  isTest      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  categories  Category[]
  orders      Order[]
  products    Product[]
  memberships UserCompany[]
}

model User {
  id          String        @id @default(cuid())
  username    String        @unique
  password    String
  createdAt   DateTime      @default(now())
  role        UserRole      @default(admin)
  memberships UserCompany[]
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(admin)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  name      String
  slug      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  emoji     String?
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([companyId])
}

model Product {
  id              String                  @id @default(cuid())
  companyId       String
  categoryId      String?
  name            String
  description     String?
  emoji           String?
  price           Decimal                 @db.Decimal(10, 2)
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  orderItems      OrderItem[]
  category        Category?               @relation(fields: [categoryId], references: [id])
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variationGroups ProductVariationGroup[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([categoryId])
}

model ProductVariationGroup {
  id             String                        @id @default(cuid())
  productId      String
  name           String
  required       Boolean                       @default(false)
  sortOrder      Int                           @default(0)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  selectionType  SelectionType
  itemSelections OrderItemVariationSelection[]
  product        Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  options        ProductVariationOption[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductVariationOption {
  id              String                              @id @default(cuid())
  groupId         String
  name            String
  priceModifier   Decimal                             @default(0) @db.Decimal(10, 2)
  sortOrder       Int                                 @default(0)
  active          Boolean                             @default(true)
  createdAt       DateTime                            @default(now())
  updatedAt       DateTime                            @updatedAt
  selectedInItems OrderItemVariationSelectionOption[]
  group           ProductVariationGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@index([groupId])
}

model Order {
  id        String      @id
  companyId String
  comanda   Int
  comandaName String?
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  paidAt    DateTime?
  status    OrderStatus
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([companyId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id         String                        @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal                       @db.Decimal(10, 2)
  totalPrice Decimal                       @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime                      @default(now())
  order      Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product                       @relation(fields: [productId], references: [id])
  variations OrderItemVariationSelection[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemVariationSelection {
  id          String                              @id @default(cuid())
  orderItemId String
  groupId     String
  createdAt   DateTime                            @default(now())
  group       ProductVariationGroup               @relation(fields: [groupId], references: [id])
  orderItem   OrderItem                           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  options     OrderItemVariationSelectionOption[]

  @@unique([orderItemId, groupId])
  @@index([orderItemId])
  @@index([groupId])
}

model OrderItemVariationSelectionOption {
  id            String                      @id @default(cuid())
  selectionId   String
  optionId      String
  priceModifier Decimal                     @db.Decimal(10, 2)
  option        ProductVariationOption      @relation(fields: [optionId], references: [id])
  selection     OrderItemVariationSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([selectionId, optionId])
  @@index([selectionId])
  @@index([optionId])
}

enum UserRole {
  admin
  cashier
  waiter
}

enum SelectionType {
  single
  multiple
}

enum OrderStatus {
  pending
  paid
  cancelled
}